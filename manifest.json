{
  "manifest_version": 3,
  "name": "Video Sniffer · 万能视频解析下载",
  "short_name": "VideoSniffer",
  "version": "1.3.0",
  "description": "粘贴视频链接即可解析并下载。内置 X/抖音/B站/微博 直连解析，可接入自定义解析 API、自建 Cobalt、本地 yt-dlp。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "clipboardRead",
    "activeTab",
    "scripting",
    "notifications",
    "offscreen"
  ],
  "optional_permissions": ["nativeMessaging"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Video Sniffer · 解析下载视频",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "resolve-current-tab": {
      "suggested_key": { "default": "Alt+D" },
      "description": "解析当前标签页的视频链接"
    }
  }
}
